# ---------------------------------------------------------------------------
# Get Home Realty admin — environment variables.
# Copy to .env.local for local dev; set the same keys in Vercel → Settings →
# Environment Variables for production. Never commit real values.
# ---------------------------------------------------------------------------

# Database. Leave unset locally to use the embedded Postgres in ./.data/pglite.
# Production: the Supabase connection string (Project → Connect → "Transaction pooler").
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# Public URL of the site, used in password-reset emails.
SITE_URL=http://localhost:3000

# First admin account — read only by `npm run db:seed` / `npm run admin:create`.
ADMIN_EMAIL=info@gethomerealty.ca
ADMIN_PASSWORD=change-me-to-a-long-passphrase
ADMIN_NAME=Get Home Realty

# Media storage. Leave unset locally (files go to public/uploads).
# Production: Supabase Storage. Create a PUBLIC bucket named below.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret
# SUPABASE_BUCKET=media

# Password-reset email via Resend (https://resend.com). Unset = reset links are
# printed to the server log instead of emailed.
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Get Home Realty <no-reply@gethomerealty.ca>

# Only needed if the public pages are hosted somewhere OTHER than this app (e.g. a
# separate static host): comma-separated site addresses allowed to submit enquiry
# forms here. Also set CONFIG.leadsApi in assets/js/main.js to this app's address.
# PUBLIC_FORM_ORIGINS=https://www.gethomerealty.ca
